{
  "run_id": "trm_primehubEnvs",
  "data_source": "primehub-reasoning-subset",
  "anchor_set": {
    "envs": [
      "primehub-reasoning-subset"
    ]
  },
  "mutations": [
    {
      "name": "primehub_reasoning_smoke",
      "batch_size": 4,
      "epochs": 1,
      "lr": 0.0002,
